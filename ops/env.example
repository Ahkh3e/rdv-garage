# /etc/rdv-ops/env  (chmod 640, owned by root:rdv-ops). Never commit a filled-in copy.
OPS_ENVIRONMENT=production            # development, test, or production
OPS_PROJECT_NAME=rdv-garage-prod      # typed to confirm production commands
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=sb_publishable_...  # the publishable key
SUPABASE_SERVICE_ROLE_KEY=sb_secret_... # the secret key; full access
OPS_AUDIT_LOG=/var/log/rdv-ops/audit.log
