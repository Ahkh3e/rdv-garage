# Public values only. Copy to .env (git-ignored) or set as EAS environment variables.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=sb_publishable_...
EXPO_PUBLIC_LINK_DOMAIN=links.example.com
# Optional JSON to switch modules off, for example {"leaderboard": false}
EXPO_PUBLIC_FLAGS={}
# Build-time only (not shipped as a runtime secret): Google Maps SDK key for the Android map.
GOOGLE_MAPS_API_KEY=
