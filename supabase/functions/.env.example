# Copy to supabase/functions/.env for local development, or set as function secrets on a hosted project:
#   supabase secrets set ENVIRONMENT=production AUTO_CONFIRM_EMAIL=false SITE_URL=https://links.example.com
# ENVIRONMENT is one of: development, test, production.
ENVIRONMENT=test
# Test mode: register confirms accounts on the server and sends no email. Honored only when
# ENVIRONMENT is development or test; ignored (and logged) in production.
AUTO_CONFIRM_EMAIL=true
# Where confirmation and reset links land (the Cloudflare Pages site built from /web).
SITE_URL=http://127.0.0.1:8788

# Walkie-talkie voice (decision 0027). Create a LiveKit Cloud project and copy its URL, API key and API secret here.
# Never commit real values. Recording and egress stay off in the LiveKit project settings.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=replace-me
LIVEKIT_API_SECRET=replace-me
# Keyed hash for the participant id. Long and random (openssl rand -hex 32). Changing it changes every participant id.
WALKIE_IDENTITY_SECRET=replace-with-64-hex-chars
# Shared with the database: the same value as private.settings walkie_kick_secret (docs/SETUP.md).
WALKIE_KICK_SECRET=replace-with-64-hex-chars
