# Copy to supabase/functions/.env for local development, or set as function secrets on a hosted project:
#   supabase secrets set ENVIRONMENT=production AUTO_CONFIRM_EMAIL=false SITE_URL=https://links.example.com
# ENVIRONMENT is one of: development, test, production.
ENVIRONMENT=test
# Test mode: register confirms accounts on the server and sends no email. Honored only when
# ENVIRONMENT is development or test; ignored (and logged) in production.
AUTO_CONFIRM_EMAIL=true
# Where confirmation and reset links land (the Cloudflare Pages site built from /web).
SITE_URL=http://127.0.0.1:8788

# Walkie-talkie voice (decision 0027). These are fake values for local development and CI only, never production.
# tests/walkie.test.ts and supabase/seed.sql assume exactly these. There is no LiveKit account behind them.
# Production values come from function secrets (docs/SETUP.md); never commit real ones.
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=devkey_local_fake
LIVEKIT_API_SECRET=local_fake_livekit_secret_0123456789abcdef
WALKIE_IDENTITY_SECRET=local-fake-identity-secret-0123456789abcdef0123456789abcdef
# Same value as private.settings walkie_kick_secret, which supabase/seed.sql sets.
WALKIE_KICK_SECRET=local-fake-kick-secret-0123456789abcdef
